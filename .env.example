# Copiar a .env y completar. Reiniciar con: npx expo start --clear
EXPO_PUBLIC_API_URL=https://sfjpii-back.onrender.com/api
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=
EXPO_PUBLIC_RECAPTCHA_BASE_URL=https://farmacia-juan-pablo-ii.web.app
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=https://farmacia-juan-pablo-ii.web.app/auth/native-callback.html
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
# Solo nativo (opcional); por defecto exp://<IP>:8081/--/auth en Expo Go. En web siempre <origen>/auth/microsoft/callback
EXPO_PUBLIC_MICROSOFT_REDIRECT_URI=
EXPO_PUBLIC_PRIVACY_NOTICE_VERSION=2026-11-01
